# Copy this file to .env (gitignored) and fill in real values.
# Also add the same values in Vercel → Project Settings → Environment Variables.

# Neon Postgres connection string (Neon dashboard → Connection Details → "Pooled connection")
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Cloudflare R2 (dashboard → R2 → your bucket)
# R2_ACCOUNT_ID: dashboard URL after login, e.g. dash.cloudflare.com/<this>
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 → Manage API Tokens → create token
# R2_BUCKET_NAME: your bucket's name
# R2_PUBLIC_URL: bucket → Settings → Public Access → enable r2.dev subdomain
#   (or a custom domain), then paste its base URL here, no trailing slash
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Random long secret used to sign admin login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Used ONCE by scripts/seed-admin.mjs to create the first admin login.
# Not read anywhere else, safe to blank out after seeding.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
